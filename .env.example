# ═══════════════════════════════════════════════════════════════
# Metal Art — Environment Variables
# Copy this file to .env.local for development
# Set real values as Docker secrets / CI variables for production
# ═══════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://metalart.sa
NEXT_PUBLIC_WHATSAPP=966500000000

# ── Moyasar (mada / Visa / Mastercard) ───────────────────────
# Docs: https://moyasar.com/docs
MOYASAR_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxx
MOYASAR_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Tabby BNPL ───────────────────────────────────────────────
# Docs: https://docs.tabby.ai
TABBY_MERCHANT_CODE=metalart
TABBY_PUBLIC_KEY=pk_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Tamara BNPL ──────────────────────────────────────────────
# Docs: https://docs.tamara.co
TAMARA_MERCHANT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TAMARA_API_URL=https://api.tamara.co

# ── STC Pay ──────────────────────────────────────────────────
# Docs: https://developer.stcpay.com.sa
STC_PAY_MERCHANT_ID=
STC_PAY_CLIENT_ID=
STC_PAY_CLIENT_SECRET=

# ── SMS — Taqnyat ────────────────────────────────────────────
# Docs: https://taqnyat.sa/documentation
TAQNYAT_TOKEN=
TAQNYAT_SENDER=MetalArt

# ── Email — Resend ───────────────────────────────────────────
# Docs: https://resend.com/docs
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=orders@metalart.sa

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Webhook secrets ──────────────────────────────────────────
MOYASAR_WEBHOOK_SECRET=
TABBY_WEBHOOK_SECRET=

# ── Database (Supabase PostgreSQL) ────────────────────────────
# Get from: Supabase → Settings → Database → Connection string
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-me-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-me-south-1.pooler.supabase.com:5432/postgres"

# ── Supabase Storage ──────────────────────────────────────────
# Get from: Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...    # NEVER expose this publicly

# ── Admin Auth ────────────────────────────────────────────────
ADMIN_JWT_SECRET=your-very-long-random-secret-at-least-32-chars

# ── Admin Seed ────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@metalart.sa
SEED_ADMIN_PASSWORD=MetalArt@2024!
SEED_ADMIN_NAME=Metal Art Admin
